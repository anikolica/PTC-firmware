[Unit]
Description=BusyBox DHCP Client for end1 (Post-SFP Init)
DefaultDependencies=no
Requires=sfp-init.service
After=sfp-init.service
BindsTo=sys-subsystem-net-devices-end1.device
After=sys-subsystem-net-devices-end1.device

[Service]
Type=simple
ExecStart=/sbin/udhcpc -i end1 -b -R -s /usr/share/udhcpc/default.script
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target